# Copy this to .env and fill in real secrets before running docker compose.
JWT_SECRET_KEY=generate-with-python-secrets-token-urlsafe-64
JWT_REFRESH_SECRET_KEY=generate-a-different-one-here

# Linux: use your LAN IP instead of host.docker.internal
# macOS/Windows Docker Desktop: the default below works as-is
OLLAMA_BASE_URL=http://host.docker.internal:11434
